{
  "manifest_version": 3,
  "name": "AcrossB Flow QR Helper (Local)",
  "version": "1.0.2",
  "description": "작업 중 배치 코드와 QR을 대조하여 행 체크박스만 선택하는 로컬 보조 도구",
  "content_scripts": [{
    "matches": ["https://axb-us-cpm-1.flow.acrossb.io/flow/work-groups*"],
    "js": ["core.js", "panel.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}

